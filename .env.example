# === LLM Provider (Primary: Gemini, Fallback: OpenAI) ===
LLM_PROVIDER=hybrid
GEMINI_API_KEY=AIzaSy-your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
ENABLE_FALLBACK=true

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# === Embedding ===
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# === PostgreSQL & pgvector ===
DATABASE_URL=postgresql+asyncpg://contentpilot:contentpilot@localhost:5432/contentpilot

# === Application ===
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO
MAX_RETRIES=2
MAX_INPUT_LENGTH=4000
MAX_OUTPUT_TOKENS=8192

# === Retrieval ===
RETRIEVAL_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# === Observability ===
TRACING_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=contentpilot
OTEL_EXPORTER_ENDPOINT=

# === Security ===
API_RATE_LIMIT=10
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
